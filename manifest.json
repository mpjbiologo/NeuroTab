{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "NeuroTab",
  "description": "__MSG_extDescription__",
  "version": "0.7.10.1",
  "default_locale": "pt_BR",
  "homepage_url": "https://github.com/mpjbiologo/NeuroTab",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "chrome_url_overrides": {
    "newtab": "src/newtab.html"
  },
  "options_page": "src/options.html",
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "contextMenus",
    "activeTab",
    "scripting",
    "favicon",
    "alarms",
    "notifications",
    "offscreen"
  ],
  "host_permissions": [
    "https://api.open-meteo.com/*",
    "https://geocoding-api.open-meteo.com/*",
    "https://api.github.com/*"
  ],
  "optional_host_permissions": [
    "https://economia.awesomeapi.com.br/*",
    "https://brapi.dev/*",
    "https://nominatim.openstreetmap.org/*",
    "https://routing.openstreetmap.de/*",
    "https://valhalla1.openstreetmap.de/*",
    "https://router.project-osrm.org/*",
    "https://www.bing.com/*",
    "https://api.nasa.gov/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.openai.com/*",
    "https://api.anthropic.com/*",
    "https://openrouter.ai/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://mail.google.com/*",
    "https://speed.cloudflare.com/*",
    "https://cloudflare-dns.com/*",
    "https://dns.google/*",
    "https://dns.quad9.net/*",
    "https://dns.adguard-dns.com/*",
    "https://doh.opendns.com/*",
    "https://dns.nextdns.io/*",
    "https://www.instagram.com/*",
    "https://www.tiktok.com/*",
    "https://www.youtube.com/*",
    "https://x.com/*",
    "https://api.fxtwitter.com/*",
    "https://t1.gstatic.com/*",
    "https://icons.duckduckgo.com/*",
    "https://*/*"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+N"
      },
      "description": "Anotar ou salvar a página atual"
    },
    "voice-command": {
      "suggested_key": {
        "default": "Alt+Shift+V"
      },
      "description": "Falar um comando de voz na NeuroTab"
    }
  },
  "optional_permissions": [
    "topSites",
    "sessions",
    "tabs",
    "identity",
    "clipboardRead",
    "nativeMessaging",
    "system.cpu",
    "system.memory"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
